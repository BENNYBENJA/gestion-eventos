# ==============================================================================
# Sistema de Gestión de Eventos y Reservas - Variables de Entorno
# ==============================================================================

# Seguridad de Django
SECRET_KEY=django-insecure-prod-key-community-events-centro-2026-change-in-production!
DEBUG=True
ALLOWED_HOSTS=*,localhost,127.0.0.1,web
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1,http://0.0.0.0,http://web

# Motor de Base de Datos: 'sqlite' para local rapido, 'mysql' para produccion
DB_ENGINE=sqlite
SQLITE_NAME=db.sqlite3

# Configuracion de MySQL (usada cuando DB_ENGINE=mysql)
DB_NAME=gestion_eventos
DB_USER=evento_user
DB_PASSWORD=evento_secure_password_2026
DB_HOST=127.0.0.1
DB_PORT=3306

# Ajustes de Seguridad para Produccion (activar cuando DEBUG=False con HTTPS)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# Nivel de Logging (DEBUG, INFO, WARNING, ERROR)
DJANGO_LOG_LEVEL=INFO
